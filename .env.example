# Broker MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_SALA=escola/sala1   # tópicos: <sala>/aluno/<id>/sinais, <sala>/aluno/<id>/agitacao, <sala>/alertas

# Telegram (crie um bot com o @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pulseira virtual
REPLAY_SPEED=10          # 10x mais rápido que o tempo real
# alunos da demo: aluno01 = S10, aluno02 = S15, aluno03 = S8 (src/iot/config.py)
